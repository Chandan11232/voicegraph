# Copy to .env.local for local dev; set the same variables in Vercel → Project → Settings → Environment Variables.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq chat model that supports JSON mode (qwen/qwen3.8-27b is faster but has a low free-tier output limit).
GROQ_MODEL=openai/gpt-oss-120b
